use_frameworks!

def stylist_pods
  pod 'Yams', '~> 5.0.6'
  pod 'KZFileWatchers', '>= 1.1', '< 2.0'
end

target 'Example' do
  platform :ios, '12.0'
  stylist_pods
end

target 'Stylist-iOS' do
  platform :ios, '12.0'
  stylist_pods
end

target 'Stylist-tvOS' do
  platform :tvos, '12.0'
  stylist_pods
end

target 'Stylist-iOS Tests' do
  platform :ios, '12.0'
  stylist_pods
end

target 'Stylist-tvOS Tests' do
  platform :tvos, '12.0'
  stylist_pods
end
